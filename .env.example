# Environment for the EML Cockpit host. All optional.

# App home: brain, sessions, the cockpit's own Claude Code and config (default ~/.eml-cockpit)
EML_COCKPIT_HOME=

# Host port (default: a free port; the dev script uses 4318)
COCKPIT_PORT=

# 1 = don't open a browser tab on start
COCKPIT_NO_OPEN=
