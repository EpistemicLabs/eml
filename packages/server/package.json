    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@engramprotocol/core": "workspace:*",
    "@engramprotocol/protocol": "workspace:*"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/ws": "^8.18.2",
    "better-sqlite3": "^13.0.3",
    "ws": "^8.22.2"
  }
}
