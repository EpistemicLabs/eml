{
  "name": "@engramprotocol/server",
  "version": "0.21.3",
  "private": true,
  "description": "EML HTTP API server",
  "license": "AGPL-3.0-only",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -b",
    "prepublishOnly": "test -f dist/server.js || (echo '❌ dist/server.js missing — run: pnpm -F @engramprotocol/core build && pnpm -F @engramprotocol/server build' && exit 1)",
